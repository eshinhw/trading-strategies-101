// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Curriculum content itself (modules, lessons, questions) is static TypeScript
// data under src/data/curriculum — same pattern as the strategy data. The
// database only holds accounts and progress against that content, referenced
// by lesson slug.

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  name         String
  createdAt    DateTime         @default(now())
  progress     LessonProgress[]
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonSlug  String
  completed   Boolean   @default(false)
  bestScore   Float? // best fraction-correct (0-1) across attempts
  attempts    Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonSlug])
}
